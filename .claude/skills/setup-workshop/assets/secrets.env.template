# Build-an-Agent workshop secrets — copy to <project>/secrets.env and fill in.
# This file is GITIGNORED and lives at /project/secrets.env inside the container;
# preBuild.bash makes ~/.bashrc source it so every notebook sees these vars.
# Set permissions to 600 (chmod 600 secrets.env) — it holds live API keys.

# ---- REQUIRED ----
# Free key from https://build.nvidia.com  (log in -> "Get API Key"). Every
# module calls NVIDIA NIM / Nemotron endpoints with it. The NGC_* mirrors are
# derived automatically by preBuild.bash, but setting them explicitly is safe.
NVIDIA_API_KEY=nvapi-REPLACE_ME
NGC_API_KEY=nvapi-REPLACE_ME
NGC_CLI_API_KEY=nvapi-REPLACE_ME
NVIDIA_NIM_API_KEY=nvapi-REPLACE_ME

# ---- OPTIONAL (recommended) ----
# Module 1's web-research tool. Free key at https://tavily.com . Omit and M1's
# live web search is disabled (the rest of M1 still runs).
# TAVILY_API_KEY=tvly-REPLACE_ME

# Module 3 tracing/observability. Key at https://smith.langchain.com . Tracing
# toggles are already set in variables.env (LANGSMITH_TRACING=true).
# LANGSMITH_API_KEY=lsv2_REPLACE_ME
