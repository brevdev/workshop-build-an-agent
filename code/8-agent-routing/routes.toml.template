# Launch it with `bash scripts/serve_local_nim.sh`, then uncomment both blocks below
# and delete the hosted [targets.weak] above. Nothing else in this file — or in your
# app — changes: same route id, same algorithm, a different place the tokens are made.
#
# [llm_clients.local_nim]
# format = "openai_chat"
# base_url = "http://nemotron:8000/v1"   # http://localhost:8000/v1 outside the workbench network
#                                        # (no api_key_env: it is your GPU, not a vendor's)
#
# [targets.weak]
# id = "nvidia/nemotron-3-nano"          # the id the NIM serves — see scripts/serve_local_nim.sh
# llm_client = "local_nim"
