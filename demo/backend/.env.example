# NVIDIA API key — free from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here

# Tavily API key (for web search) — free from https://tavily.com
TAVILY_API_KEY=tvly-your-key-here

# Docker socket (for sandbox mode). Leave unset to auto-detect: the backend
# prefers the workshop's mounted host socket (/var/host-run/docker.sock), then
# the standard Linux socket (/var/run/docker.sock). Only set this to override.
#
# Linux / Docker Desktop (usually auto-detected — leave commented):
# DOCKER_HOST=unix:///var/run/docker.sock
# macOS + Colima (standalone demo on a Mac):
# DOCKER_HOST=unix:///Users/YOUR_USERNAME/.colima/default/docker.sock
